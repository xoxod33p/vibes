SESSION_SECRET=
YTDLP_PATH=
COOKIES_PATH=

# Firebase Cloud Firestore Credentials
# Option 1: Individual Environment Variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2: Full Service Account JSON String
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":...}

# Option 3: Path to Service Account JSON file (or place serviceAccountKey.json in project root)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
