# ==========================================
# Server Configuration (server.js)
# ==========================================
PORT=5000
HOSTNAME=0.0.0.0
NODE_ENV=development

# ==========================================
# Authentication & Security (lib/auth.ts)
# ==========================================
SESSION_SECRET=your-random-32-character-secret-key-here
COOKIE_SECURE=false

# ==========================================
# Media Resolution & yt-dlp Configuration
# ==========================================
YTDLP_PATH=yt-dlp
COOKIES_PATH=./cookies.txt

# ==========================================
# Firebase Cloud Firestore Configuration
# ==========================================
# Option 1: Individual Environment Variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2: Full Service Account JSON String
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":...}

# Option 3: Path to Service Account JSON File
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
