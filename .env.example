# Session secret for cookie signing (change this in production!)
SESSION_SECRET=vibes-change-me-to-something-random

# Absolute path to yt-dlp binary (defaults to "yt-dlp" from PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Absolute path to cookies.txt for YouTube auth (defaults to auto-detect)
# COOKIES_PATH=/home/admin/vibes/cookies.txt
