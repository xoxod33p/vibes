# ==============================================================================
# Vibes Music Player - Environment Configuration
# Copy this file to .env and customize for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=5000
HOSTNAME=0.0.0.0
# Set to 'production' for production deployments, 'development' for local
NODE_ENV=production

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign session JWTs (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-secure-random-32-character-secret-key

# Set to true if running behind HTTPS / SSL reverse proxy (Nginx, Caddy, Cloudflare)
# Set to false if accessing directly over HTTP (e.g. http://localhost:5000)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Media & Downloader (yt-dlp)
# ------------------------------------------------------------------------------
# In Docker, yt-dlp is pre-installed in system PATH as 'yt-dlp'
YTDLP_PATH=yt-dlp

# Path to YouTube cookies file (Netscape format) to bypass bot/403 verification
# Local development:  ./cookies.txt
COOKIES_PATH=./cookies.txt

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Server-Side Persistence)
# ------------------------------------------------------------------------------
# Option 1: File path to serviceAccountKey.json
# Local development:  ./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Paste the entire service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# Google OAuth (Optional - Social Login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Firebase Client SDK (Optional - Client-Side Auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
